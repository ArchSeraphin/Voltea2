# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MySQL ───────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=voltea_user
DB_PASSWORD=your_password_here
DB_NAME=voltea_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_64_chars_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_64_chars_minimum
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://voltea2.voilavoila.tv,https://voltea-energie.fr

# ─── Email (Contact Form) ────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@voltea-energie.fr
SMTP_PASS=your_smtp_password
MAIL_FROM=contact@voltea-energie.fr
MAIL_TO=contact@voltea-energie.fr

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/uploads/voltea
MAX_FILE_SIZE_MB=5

# ─── Site ────────────────────────────────────────────────────────────────────
SITE_URL=https://voltea-energie.fr
